# Schema-owner credentials. Read ONLY by `php artisan arkon:migrate`, `arkon:db-bootstrap` and the
# test harness (database resets). The web app never loads this file and refuses to serve if these
# variables are present in its environment. Host, port and database names come from .env.
MIGRATION_DB_USERNAME=arkonlaravel_owner
MIGRATION_DB_PASSWORD=CHANGE_ME_OWNER
