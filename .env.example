APP_NAME=Arkon
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://arkonlaravel.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Runtime connection: restricted role (DML only, append-only history tables, no DDL).
# Never put the schema-owner or superuser credentials in this file.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=arkonlaravel
DB_USERNAME=arkonlaravel_app
DB_PASSWORD=CHANGE_ME_APP
# Test databases use the same credentials: arkonlaravel_test (PHPUnit), arkonlaravel_e2e (Playwright).

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_COOKIE=arkon_session
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true when serving over HTTPS.
SESSION_SECURE_COOKIE=false

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Uploaded media (relative to the project root). Private until published.
ARKON_MEDIA_ROOT=storage/app/media

# Hostnames served by the seeded demo site (`php artisan arkon:seed`).
ARKON_SEED_HOSTS=arkonlaravel.test

# AI page proposals run on your own Claude subscription through Claude Code (no API key, no API billing).
# Prompting in VS Code: pair with `php artisan arkon:ai-pair you@example.com --mcp` (prints the `claude mcp add` command).
# Prompting in the editor's AI panel: pair with `php artisan arkon:ai-pair you@example.com --helper`, then keep
# `php artisan arkon:ai-helper` running. All settings below are optional (defaults shown or empty).
# Claude Code's executable: empty finds claude.exe on PATH, in ~/.local/bin or in the VS Code extension.
ARKON_CLAUDE_COMMAND=
# Model alias for the helper's runs (sonnet, opus, ...); empty uses Claude Code's default.
ARKON_AI_MODEL=
ARKON_AI_RUN_TIMEOUT=240
# How often Arkon starts requests (Claude Code itself enforces your subscription's usage limits).
ARKON_AI_PER_USER_PER_MINUTE=5
ARKON_AI_PER_SITE_PER_DAY=100
ARKON_AI_MAX_ACTIVE_PER_SITE=2
