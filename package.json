{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "format": "prettier --write resources/js tests/conformance e2e",
        "check": "npm run typecheck && npm run test",
        "test:herd": "playwright test -c playwright.herd.config.ts",
        "perf": "node scripts/perf.mjs"
    },
    "devDependencies": {
        "@inertiajs/react": "^3.8.0",
        "@playwright/test": "^1.63.0",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^26.6.4",
        "@types/pg": "^8.23.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "pg": "^8.23.1",
        "prettier": "^3.9.9",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "tailwindcss": "^4.0.0",
        "typescript": "^7.0.2",
        "vite": "^8.0.0",
        "vitest": "^5.0.3"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "overrides": {
        "concurrently": {
            "shell-quote": "1.11.0"
        }
    }
}
