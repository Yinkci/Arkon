# Secrets: never commit
.env
.env.*
!.env.example
.migrate.env
!.migrate.env.example
*.pem
*.key
auth.json

# Dependencies and build output
/vendor
/node_modules
/public/build
/public/hot
/public/storage
/public/fonts-manifest.dev.json

# Local data (uploaded media, sessions, caches, logs)
/storage/*.key
/storage/pail
/storage/app/media
/storage/e2e
/storage/perf
/storage/perf-*
/storage/screenshots
/storage/testing
*.log

# Test output
.phpunit.result.cache
/.phpunit.cache
/test-results
/storage/playwright
/playwright-report
/blob-report
/coverage

# OS / editor
.DS_Store
Thumbs.db
/.idea
/.vscode
/.zed
/.cursor
/.codex
/.nova
.phpactor.json
_ide_helper.php

# Immutable developer component snapshots: deploy and back up separately
/storage/app/theme-components
/storage/framework/testing/theme-components

# Database/media backup bundles contain private site data
/storage/app/private/backups
