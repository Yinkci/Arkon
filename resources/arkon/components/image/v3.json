{
  "type": "image",
  "version": 3,
  "label": "Image",
  "children": false,
  "props": {
    "image": {
      "type": "object",
      "nullable": true,
      "default": null,
      "properties": {
        "assetId": {
          "type": "uuid"
        },
        "alt": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "caption": {
      "type": "string",
      "maxLength": 300,
      "default": ""
    },
    "loading": {
      "type": "enum",
      "values": [
        "auto",
        "eager",
        "lazy"
      ],
      "default": "auto"
    },
    "style": {
      "type": "style",
      "slots": {
        "root": {
          "label": "Block",
          "groups": [
            "spacing",
            "size",
            "placement"
          ]
        },
        "media": {
          "label": "Image",
          "groups": [
            "size",
            "image",
            "border",
            "effects"
          ]
        },
        "caption": {
          "label": "Caption",
          "groups": [
            "typography"
          ]
        }
      },
      "default": {}
    }
  },
  "defaultProps": {
    "image": null,
    "caption": "",
    "loading": "auto",
    "style": {}
  },
  "inlineFields": {
    "caption": {
      "kind": "line"
    }
  },
  "mediaRefs": [
    "image.assetId"
  ],
  "publishChecks": [
    {
      "rule": "present",
      "prop": "image",
      "message": "Image block has no image"
    },
    {
      "rule": "notBlank",
      "prop": "image.alt",
      "when": "image",
      "message": "Image needs alternative text"
    }
  ]
}
