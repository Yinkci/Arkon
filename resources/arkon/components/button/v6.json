{
  "type": "button",
  "version": 6,
  "label": "Button",
  "children": false,
  "props": {
    "label": {
      "type": "string",
      "maxLength": 80
    },
    "href": {
      "type": "link",
      "maxLength": 2000,
      "default": "#"
    },
    "variant": {
      "type": "enum",
      "values": [
        "primary",
        "secondary",
        "text"
      ],
      "default": "primary"
    },
    "size": {
      "type": "enum",
      "values": [
        "small",
        "medium",
        "large"
      ],
      "default": "medium"
    },
    "newTab": {
      "type": "boolean",
      "default": false
    },
    "style": {
      "type": "style",
      "slots": {
        "root": {
          "label": "Block",
          "groups": [
            "spacing",
            "placement",
            "motion",
            "interaction"
          ],
          "properties": [
            "textAlign"
          ]
        },
        "button": {
          "label": "Button",
          "groups": [
            "typography",
            "background",
            "border",
            "effects",
            "spacing",
            "interaction"
          ],
          "properties": [
            "width",
            "minWidth"
          ]
        }
      },
      "default": {}
    },
    "responsive": {
      "type": "object",
      "properties": {
        "tablet": {
          "type": "object",
          "properties": {
            "variant": {
              "type": "enum",
              "values": [
                "inherit",
                "primary",
                "secondary",
                "text"
              ],
              "default": "inherit"
            },
            "size": {
              "type": "enum",
              "values": [
                "inherit",
                "small",
                "medium",
                "large"
              ],
              "default": "inherit"
            }
          },
          "default": {
            "variant": "inherit",
            "size": "inherit"
          }
        },
        "mobile": {
          "type": "object",
          "properties": {
            "variant": {
              "type": "enum",
              "values": [
                "inherit",
                "primary",
                "secondary",
                "text"
              ],
              "default": "inherit"
            },
            "size": {
              "type": "enum",
              "values": [
                "inherit",
                "small",
                "medium",
                "large"
              ],
              "default": "inherit"
            }
          },
          "default": {
            "variant": "inherit",
            "size": "inherit"
          }
        }
      },
      "default": {
        "tablet": {
          "variant": "inherit",
          "size": "inherit"
        },
        "mobile": {
          "variant": "inherit",
          "size": "inherit"
        }
      }
    }
  },
  "defaultProps": {
    "label": "Learn more",
    "href": "#",
    "variant": "primary",
    "size": "medium",
    "newTab": false,
    "style": {},
    "responsive": {
      "tablet": {
        "variant": "inherit",
        "size": "inherit"
      },
      "mobile": {
        "variant": "inherit",
        "size": "inherit"
      }
    }
  },
  "inlineFields": {
    "label": {
      "kind": "line"
    }
  },
  "publishChecks": [
    {
      "rule": "notBlank",
      "prop": "label",
      "message": "Button needs a label"
    },
    {
      "rule": "notBlank",
      "prop": "href",
      "message": "Button needs a link"
    }
  ]
}
