{
  "type": "section",
  "version": 6,
  "label": "Section",
  "children": {
    "allow": [
      "hero",
      "text",
      "image",
      "button",
      "group",
      "columns",
      "instance",
      "form",
      "navigation",
      "logo",
      "icon",
      "slider",
      "back-to-top"
    ],
    "max": 30
  },
  "props": {
    "element": {
      "type": "enum",
      "values": [
        "section",
        "div",
        "header",
        "footer",
        "aside"
      ],
      "default": "section"
    },
    "contentWidth": {
      "type": "enum",
      "values": [
        "narrow",
        "default",
        "wide",
        "full"
      ],
      "default": "default"
    },
    "style": {
      "type": "style",
      "slots": {
        "root": {
          "label": "Section",
          "groups": [
            "layout",
            "spacing",
            "size",
            "background",
            "border",
            "effects",
            "typography",
            "motion",
            "interaction"
          ]
        }
      },
      "default": {}
    },
    "anchor": {
      "type": "string",
      "maxLength": 64,
      "default": "",
      "pattern": "^(?:[a-zA-Z][a-zA-Z0-9_-]{0,63})?$"
    },
    "responsive": {
      "type": "object",
      "properties": {
        "tablet": {
          "type": "object",
          "properties": {
            "contentWidth": {
              "type": "enum",
              "values": [
                "inherit",
                "narrow",
                "default",
                "wide",
                "full"
              ],
              "default": "inherit"
            }
          },
          "default": {
            "contentWidth": "inherit"
          }
        },
        "mobile": {
          "type": "object",
          "properties": {
            "contentWidth": {
              "type": "enum",
              "values": [
                "inherit",
                "narrow",
                "default",
                "wide",
                "full"
              ],
              "default": "inherit"
            }
          },
          "default": {
            "contentWidth": "inherit"
          }
        }
      },
      "default": {
        "tablet": {
          "contentWidth": "inherit"
        },
        "mobile": {
          "contentWidth": "inherit"
        }
      }
    }
  },
  "defaultProps": {
    "element": "section",
    "contentWidth": "default",
    "style": {},
    "anchor": "",
    "responsive": {
      "tablet": {
        "contentWidth": "inherit"
      },
      "mobile": {
        "contentWidth": "inherit"
      }
    }
  }
}
