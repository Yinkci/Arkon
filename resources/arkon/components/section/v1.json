{
  "type": "section",
  "version": 1,
  "label": "Section",
  "children": {
    "allow": [
      "hero",
      "text",
      "image",
      "button",
      "group",
      "columns",
      "instance"
    ],
    "max": 30
  },
  "props": {
    "element": {
      "type": "enum",
      "values": [
        "section",
        "div",
        "header",
        "footer",
        "aside"
      ],
      "default": "section"
    },
    "contentWidth": {
      "type": "enum",
      "values": [
        "narrow",
        "default",
        "wide",
        "full"
      ],
      "default": "default"
    },
    "style": {
      "type": "style",
      "slots": {
        "root": {
          "label": "Section",
          "groups": [
            "layout",
            "spacing",
            "size",
            "background",
            "border",
            "effects",
            "typography"
          ]
        }
      },
      "default": {}
    }
  },
  "defaultProps": {
    "element": "section",
    "contentWidth": "default",
    "style": {}
  }
}
