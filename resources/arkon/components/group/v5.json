{
  "type": "group",
  "version": 5,
  "label": "Group",
  "children": {
    "allow": [
      "text",
      "image",
      "button",
      "group",
      "columns",
      "instance",
      "form",
      "navigation",
      "logo",
      "icon",
      "slider",
      "back-to-top"
    ],
    "max": 30
  },
  "props": {
    "element": {
      "type": "enum",
      "values": [
        "div",
        "section",
        "article",
        "aside",
        "header",
        "footer",
        "nav"
      ],
      "default": "div"
    },
    "style": {
      "type": "style",
      "slots": {
        "root": {
          "label": "Group",
          "groups": [
            "layout",
            "spacing",
            "size",
            "placement",
            "background",
            "border",
            "effects",
            "motion",
            "interaction",
            "typography"
          ]
        }
      },
      "default": {}
    }
  },
  "defaultProps": {
    "element": "div",
    "style": {}
  }
}
