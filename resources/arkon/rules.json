{
  "$comment": "Shared validation rules. Read by PHP (app/Arkon/Support/Rules.php) and TypeScript (resources/js/arkon/rules.ts). Changing a rule changes both; tests/Conformance pins the behaviour of both implementations.",
  "schemaVersion": 1,
  "maxDepth": 8,
  "maxNodes": 2000,
  "patterns": {
    "nodeId": "^[A-Za-z0-9_-]{4,32}$",
    "componentType": "^[a-z][a-z0-9-]{0,39}$",
    "propKey": "^[A-Za-z][A-Za-z0-9]{0,39}$",
    "requestKey": "^[A-Za-z0-9_-]{16,100}$",
    "uuid": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
    "pathSegment": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
    "link": "^(?:|/(?!/)[!-\\[\\]-~]*|#[!-\\[\\]-~]*|\\?[!-\\[\\]-~]*|https?://(?![/?#])[!-\\[\\]-~]+|mailto:[!-?A-\\[\\]-~]+@[!-\\[\\]-~]+|tel:[0-9+().\\-]+)$",
    "linkRecorded": "^(?:|/(?!/)[!-~]*|#[!-~]*|\\?[!-~]*|https?://(?![/?#])[!-~]+|mailto:[!-?A-~]+@[!-~]+|tel:[0-9+().\\-]+)$",
    "styleLength": "^(-?(?:[0-9]{1,5}(?:[.][0-9]{1,3})?|[.][0-9]{1,3}))(px|rem|em|%|vw|vh|ch)$",
    "styleNumber": "^[0-9]{1,2}(?:[.][0-9]{1,3})?$",
    "styleColor": "^#(?:[0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
    "styleRatio": "^[1-9][0-9]{0,2}/[1-9][0-9]{0,2}$",
    "styleTrack": "^[0-9]{1,2}(?:[.][0-9]{1,2})?fr$",
    "styleToken": "^@([A-Za-z]+)[.]([A-Za-z0-9]+)$",
    "styleTime": "^[0-9]{1,4}ms$"
  },
  "limits": {
    "variant": 40,
    "editorName": 80,
    "pageTitle": 120,
    "path": 200,
    "operations": 1000,
    "insertNodes": 200,
    "saveMessage": 200
  },
  "seo": {
    "title": {
      "type": "string",
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 320
    },
    "noindex": {
      "type": "boolean"
    }
  },
  "reservedPathSegments": [
    "admin",
    "login",
    "logout",
    "api",
    "preview",
    "media",
    "build"
  ],
  "messages": {
    "expectedObject": "Expected an object",
    "expectedString": "Expected a string",
    "expectedBoolean": "Expected a boolean",
    "expectedList": "Expected a list",
    "expectedPositiveInteger": "Expected a positive integer",
    "required": "Required",
    "unrecognizedKey": "Unrecognized key \"{key}\"",
    "tooLong": "Too long: at most {max} characters",
